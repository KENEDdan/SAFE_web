DEBUG=True
SECRET_KEY=
ALLOWED_HOSTS=localhost,127.0.0.1
# Set to True only when deployed behind a reverse proxy that terminates TLS
# itself and sets X-Forwarded-Proto — never on a box that receives traffic
# directly.
BEHIND_HTTPS_PROXY=False

# Secret path the staff console + login portal are served from. Nothing on the
# public site links to it. Generate one with:
#   python -c "import secrets; print('office-' + secrets.token_hex(8))"
STAFF_URL_PREFIX=

POSTGRES_DB=safe_db
POSTGRES_USER=safe_user
POSTGRES_PASSWORD=safe_pass
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=55432

# Email — leave the credentials blank to print emails to the console (dev).
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=SAFE <no-reply@safe-ss.org>
