DEBUG=False
SECRET_KEY=
ALLOWED_HOSTS=safe-ss.org,www.safe-ss.org,206.189.9.50
# Nginx on the host terminates TLS and proxies to the app container — keep this True.
BEHIND_HTTPS_PROXY=True
CSRF_TRUSTED_ORIGINS=https://safe-ss.org,https://www.safe-ss.org

# Secret path the staff console + login portal are served from. Nothing on the
# public site links to it. Generate one with:
#   python -c "import secrets; print('office-' + secrets.token_hex(8))"
STAFF_URL_PREFIX=

POSTGRES_DB=safe_db
POSTGRES_USER=safe_user
POSTGRES_PASSWORD=
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Email — leave the credentials blank to print emails to the console.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=SAFE <no-reply@safe-ss.org>
